diff --git a/app/web/src/App.css b/app/web/src/App.css
new file mode 100644
index 0000000..acafbac
--- /dev/null
+++ b/app/web/src/App.css
@@ -0,0 +1,118 @@
+.app {
+  display: grid;
+  grid-template-columns: 1fr 1fr 1fr;
+  height: 100vh;
+  width: 100vw;
+  box-sizing: border-box;
+}
+
+.col {
+  overflow: auto;
+  padding: 12px;
+  border-right: 1px solid #ccc;
+  box-sizing: border-box;
+}
+
+.col:last-child {
+  border-right: none;
+}
+
+h1,
+h2,
+h3 {
+  margin: 0 0 8px;
+  font-size: 1.1rem;
+}
+
+h1 {
+  font-size: 1.25rem;
+}
+
+.doctor {
+  list-style: none;
+  padding: 0;
+  margin: 0 0 12px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.ok {
+  color: #0a0;
+}
+
+.bad {
+  color: #c00;
+}
+
+.folder-row {
+  display: flex;
+  gap: 8px;
+  margin-bottom: 12px;
+}
+
+.folder-row input {
+  flex: 1;
+  min-width: 0;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-top: 12px;
+}
+
+button.link {
+  background: none;
+  border: none;
+  padding: 0;
+  color: #06c;
+  text-align: left;
+  cursor: pointer;
+  text-decoration: underline;
+}
+
+button:disabled {
+  cursor: not-allowed;
+}
+
+pre {
+  white-space: pre-wrap;
+  word-break: break-word;
+  background: #f4f4f4;
+  padding: 8px;
+  max-height: 30vh;
+  overflow: auto;
+}
+
+video {
+  width: 100%;
+  max-height: 280px;
+  background: #000;
+  margin: 8px 0;
+}
+
+.error {
+  color: #c00;
+}
+
+.job {
+  font-family: ui-monospace, Consolas, monospace;
+}
+
+.chat-log {
+  min-height: 8rem;
+  max-height: 50vh;
+  overflow: auto;
+  border: 1px solid #ccc;
+  padding: 8px;
+  margin-bottom: 8px;
+}
+
+textarea {
+  width: 100%;
+  min-height: 80px;
+  box-sizing: border-box;
+  margin-bottom: 8px;
+}
