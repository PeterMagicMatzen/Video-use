+    env = helper_env()
+    assert env["PYTHONIOENCODING"] == "utf-8"
+    assert env["PYTHONUTF8"] == "1"
+    assert env["FOO"] == "1"
+
+
+def test_probe_parses_ffprobe():
+    payload = {
+        "format": {"duration": "12.5"},
+        "streams": [
+            {"codec_type": "audio"},
+            {"codec_type": "video", "width": 1920, "height": 1080, "avg_frame_rate": "30000/1001"},
+        ],
+    }
+    def run(cmd, **kwargs):
+        class R:
+            returncode = 0
+            stdout = json.dumps(payload)
+            stderr = ""
